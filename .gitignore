# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
supabase/.temp/

# 디자인 원본 — 앱은 public/sejung-logo.png 를 쓰고 .ai/.psd 는 빌드에 안 들어간다.
# 수 MB 바이너리라 레포에 두면 clone 만 무거워진다(원본은 디자인 폴더에 보관).
*.ai
*.psd

# ETL · Python
.venv/
scripts/etl/.env
scripts/etl/explore_output/
scripts/etl/logs/
__pycache__/
*.pyc
.env*.local

# 아카2000 문자 로그 원본 (MS Access). 파일 하나가 최대 2GB 라 절대 커밋하지 않는다.
# 0131 마이그레이션의 aca_sms_messages / aca_sms_bodies 로 적재한 뒤 로컬에서만 보관.
# 아래 `*.mdb *` 는 macOS 가 중복 파일에 붙이는 이름(`… .mdb 2`)까지 막는다.
*.mdb
*.mdb *

# 문자 발송 로그 엑셀 원본. 학부모 연락처·본문이 그대로 들어 있어 커밋하면
# 개인정보가 레포에 박힌다(git 은 지워도 히스토리에 남는다). *.mdb 와 같은 이유.
# ~$ 는 엑셀이 파일을 열어 두는 동안 만드는 잠금 파일.
*.xlsx
*.xls
~$*
